<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane fx:id="panelFormulario" prefHeight="470.0"
	prefWidth="640.0" style="-fx-background-color: #ffffff; -fx-border-color: #b0bec5;"
	xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
	fx:controller="controlador.ControladorInsumos">
	<padding>
		<Insets bottom="14.0" left="14.0" right="14.0" top="14.0" />
	</padding>
	<top>
		<VBox spacing="12.0">
			<Label style="-fx-font-size: 15px; -fx-font-weight: bold;"
				text="Administración de Productos / Insumos (ListView, TableView e ImageView)" />
			<HBox alignment="CENTER_LEFT" spacing="20.0">
				<GridPane hgap="10.0" vgap="8.0" HBox.hgrow="ALWAYS">
					<columnConstraints>
						<ColumnConstraints minWidth="75.0" prefWidth="85.0" />
						<ColumnConstraints hgrow="ALWAYS" minWidth="180.0"
							prefWidth="220.0" />
					</columnConstraints>
					<rowConstraints>
						<RowConstraints minHeight="28.0" />
						<RowConstraints minHeight="28.0" />
						<RowConstraints minHeight="65.0" />
					</rowConstraints>
					<children>
						<Label fx:id="labelId" text="ID:" GridPane.columnIndex="0"
							GridPane.rowIndex="0" />
						<TextField fx:id="Tid" editable="false"
							GridPane.columnIndex="1" GridPane.rowIndex="0" />

						<Label fx:id="labelInsumo" text="Insumo:"
							GridPane.columnIndex="0" GridPane.rowIndex="1" />
						<TextField fx:id="Tinsumo" editable="false"
							GridPane.columnIndex="1" GridPane.rowIndex="1" />

						<Label fx:id="labelCategoria" text="Categoría:"
							GridPane.columnIndex="0" GridPane.rowIndex="2" />
						<ScrollPane fx:id="scrollPane_jlist" fitToHeight="true"
							fitToWidth="true" prefHeight="65.0" vbarPolicy="ALWAYS"
							GridPane.columnIndex="1" GridPane.rowIndex="2">
							<content>
								<ListView fx:id="ListaCategoria" disable="true"
									prefHeight="60.0" />
							</content>
						</ScrollPane>
					</children>
				</GridPane>
				<StackPane prefHeight="115.0" prefWidth="150.0"
					style="-fx-border-color: #cfd8dc; -fx-background-color: #f8fafc;">
					<children>
						<ImageView fx:id="Limagen" fitHeight="107.0"
							fitWidth="142.0" pickOnBounds="true" preserveRatio="true" />
					</children>
				</StackPane>
			</HBox>
			<HBox alignment="CENTER" spacing="12.0">
				<Button fx:id="Bagregar" onAction="#onAltas" prefWidth="115.0"
					text="Agregar" />
				<Button fx:id="Bmodal" onAction="#onAbrirModalInsumo"
					prefWidth="165.0" text="Agregar/Modificar (Modal)" />
				<Button fx:id="Beliminar" onAction="#onEliminar"
					prefWidth="115.0" text="Eliminar" />
				<Button fx:id="Bsalir" onAction="#onSalir" prefWidth="95.0"
					text="Salir" />
			</HBox>
		</VBox>
	</top>
	<center>
		<ScrollPane fx:id="scrollPane" fitToHeight="true"
			fitToWidth="true" BorderPane.alignment="CENTER">
			<BorderPane.margin>
				<Insets top="12.0" />
			</BorderPane.margin>
			<content>
				<TableView fx:id="TareaProductos">
					<columns>
						<TableColumn fx:id="colId" prefWidth="90.0" text="Id" />
						<TableColumn fx:id="colInsumo" prefWidth="250.0"
							text="Insumo" />
						<TableColumn fx:id="colCategoria" prefWidth="220.0"
							text="Categoria" />
					</columns>
				</TableView>
			</content>
		</ScrollPane>
	</center>
</BorderPane>
