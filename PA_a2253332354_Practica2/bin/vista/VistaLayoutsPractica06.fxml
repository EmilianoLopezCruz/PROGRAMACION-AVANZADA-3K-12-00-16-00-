<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.TilePane?>
<?import javafx.scene.layout.VBox?>

<BorderPane fx:id="panelLayouts" prefHeight="470.0" prefWidth="650.0"
	style="-fx-background-color: #ffffff; -fx-border-color: #b0bec5;"
	xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
	fx:controller="controlador.ControladorLayoutsPractica06">
	<top>
		<HBox alignment="CENTER_LEFT" spacing="15.0">
			<padding>
				<Insets bottom="10.0" left="12.0" right="12.0" top="10.0" />
			</padding>
			<children>
				<Label style="-fx-font-size: 15px; -fx-font-weight: bold;"
					text="Práctica 06_a, 06_b, 06_c y 06_d — Demostración de Layouts en JavaFX" />
				<Button fx:id="btnCerrarLayouts" onAction="#onSalir"
					text="Salir al Menú" />
			</children>
		</HBox>
	</top>
	<center>
		<TabPane fx:id="tabLayouts" tabClosingPolicy="UNAVAILABLE">
			<tabs>
				<Tab text="Practica06_a (FlowPane / FlowLayout)">
					<content>
						<FlowPane alignment="TOP_CENTER" hgap="12.0" vgap="12.0">
							<padding>
								<Insets bottom="12.0" left="12.0" right="12.0" top="12.0" />
							</padding>
							<children>
								<HBox alignment="CENTER" spacing="8.0">
									<Label text="ID:" />
									<TextField prefWidth="90.0" text="001" />
									<Label text="Insumo:" />
									<TextField prefWidth="120.0" text="Cemento" />
								</HBox>
								<HBox alignment="CENTER" spacing="8.0">
									<Label text="Categoría:" />
									<ListView fx:id="listFlow" prefHeight="55.0"
										prefWidth="160.0" />
								</HBox>
								<TableView fx:id="tablaFlow" prefHeight="190.0"
									prefWidth="520.0">
									<columns>
										<TableColumn fx:id="colFlowId" prefWidth="90.0" text="Id" />
										<TableColumn fx:id="colFlowIns" prefWidth="210.0"
											text="Insumo" />
										<TableColumn fx:id="colFlowCat" prefWidth="200.0"
											text="Categoria" />
									</columns>
								</TableView>
								<HBox alignment="CENTER" spacing="12.0">
									<Button text="Agregar" />
									<Button text="Eliminar" />
									<Button onAction="#onSalir" text="Salir" />
								</HBox>
							</children>
						</FlowPane>
					</content>
				</Tab>
				<Tab text="Practica06_b (BorderPane / BorderLayout)">
					<content>
						<BorderPane>
							<padding>
								<Insets bottom="12.0" left="12.0" right="12.0" top="12.0" />
							</padding>
							<top>
								<VBox alignment="CENTER" spacing="8.0">
									<HBox alignment="CENTER" spacing="8.0">
										<Label text="Zona NORTH - Panel 1 | ID:" />
										<TextField prefWidth="100.0" text="001" />
										<Label text="Insumo:" />
										<TextField prefWidth="140.0" text="Cemento" />
									</HBox>
									<HBox alignment="CENTER" spacing="8.0">
										<Label text="Zona NORTH - Panel 2 | Categoría:" />
										<ListView fx:id="listBorder" prefHeight="55.0"
											prefWidth="180.0" />
									</HBox>
								</VBox>
							</top>
							<center>
								<TableView fx:id="tablaBorder">
									<BorderPane.margin>
										<Insets bottom="10.0" top="10.0" />
									</BorderPane.margin>
									<columns>
										<TableColumn fx:id="colBorderId" prefWidth="90.0"
											text="Id" />
										<TableColumn fx:id="colBorderIns" prefWidth="220.0"
											text="Insumo" />
										<TableColumn fx:id="colBorderCat" prefWidth="220.0"
											text="Categoria" />
									</columns>
								</TableView>
							</center>
							<bottom>
								<HBox alignment="CENTER" spacing="12.0">
									<Label text="Zona SOUTH - Panel 4:" />
									<Button text="Agregar" />
									<Button text="Eliminar" />
									<Button onAction="#onSalir" text="Salir" />
								</HBox>
							</bottom>
						</BorderPane>
					</content>
				</Tab>
				<Tab text="Practica06_c (TilePane / GridLayout 4 Filas)">
					<content>
						<TilePane orientation="VERTICAL" prefRows="4"
							tileAlignment="CENTER" vgap="8.0">
							<padding>
								<Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
							</padding>
							<children>
								<HBox alignment="CENTER" spacing="8.0"
									style="-fx-border-color: #cfd8dc; -fx-padding: 6;">
									<Label text="Fila 1 (Mismo Alto): ID:" />
									<TextField prefWidth="90.0" text="001" />
									<Label text="Insumo:" />
									<TextField prefWidth="120.0" text="Cemento" />
								</HBox>
								<HBox alignment="CENTER" spacing="8.0"
									style="-fx-border-color: #cfd8dc; -fx-padding: 6;">
									<Label text="Fila 2 (Mismo Alto): Categoría:" />
									<ListView fx:id="listGrid" prefHeight="55.0"
										prefWidth="180.0" />
								</HBox>
								<TableView fx:id="tablaGrid" prefHeight="75.0"
									prefWidth="520.0">
									<columns>
										<TableColumn fx:id="colGridId" prefWidth="90.0" text="Id" />
										<TableColumn fx:id="colGridIns" prefWidth="210.0"
											text="Insumo" />
										<TableColumn fx:id="colGridCat" prefWidth="200.0"
											text="Categoria" />
									</columns>
								</TableView>
								<HBox alignment="CENTER" spacing="12.0"
									style="-fx-border-color: #cfd8dc; -fx-padding: 6;">
									<Label text="Fila 4 (Mismo Alto):" />
									<Button text="Agregar" />
									<Button text="Eliminar" />
									<Button onAction="#onSalir" text="Salir" />
								</HBox>
							</children>
						</TilePane>
					</content>
				</Tab>
				<Tab text="Practica06_d (GridPane / GridBagLayout 6 Filas)">
					<content>
						<GridPane vgap="8.0">
							<padding>
								<Insets bottom="12.0" left="12.0" right="12.0" top="12.0" />
							</padding>
							<columnConstraints>
								<ColumnConstraints hgrow="ALWAYS" />
							</columnConstraints>
							<rowConstraints>
								<RowConstraints prefHeight="50.0" />
								<RowConstraints prefHeight="65.0" />
								<RowConstraints prefHeight="180.0" vgrow="ALWAYS" />
								<RowConstraints prefHeight="50.0" />
							</rowConstraints>
							<children>
								<HBox alignment="CENTER" spacing="8.0"
									GridPane.rowIndex="0">
									<Label text="Fila 1 (Panel 1) - ID:" />
									<TextField prefWidth="90.0" text="001" />
									<Label text="Insumo:" />
									<TextField prefWidth="140.0" text="Cemento" />
								</HBox>
								<HBox alignment="CENTER" spacing="8.0"
									GridPane.rowIndex="1">
									<Label text="Fila 2 (Panel 2) - Categoría:" />
									<ListView fx:id="listGridBag" prefHeight="55.0"
										prefWidth="180.0" />
								</HBox>
								<TableView fx:id="tablaGridBag" GridPane.rowIndex="2">
									<columns>
										<TableColumn fx:id="colBagId" prefWidth="90.0" text="Id" />
										<TableColumn fx:id="colBagIns" prefWidth="220.0"
											text="Insumo" />
										<TableColumn fx:id="colBagCat" prefWidth="220.0"
											text="Categoria" />
									</columns>
								</TableView>
								<HBox alignment="CENTER" spacing="12.0"
									GridPane.rowIndex="3">
									<Label text="Fila 6 (Panel 4):" />
									<Button text="Agregar" />
									<Button text="Eliminar" />
									<Button onAction="#onSalir" text="Salir" />
								</HBox>
							</children>
						</GridPane>
					</content>
				</Tab>
			</tabs>
		</TabPane>
	</center>
</BorderPane>
