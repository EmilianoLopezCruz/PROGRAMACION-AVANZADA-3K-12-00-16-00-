<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>

<BorderPane fx:id="panelFormulario" prefHeight="430.0"
	prefWidth="560.0" style="-fx-background-color: #ffffff; -fx-border-color: #b0bec5;"
	xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
	fx:controller="controlador.ControladorCategorias">
	<padding>
		<Insets bottom="14.0" left="14.0" right="14.0" top="14.0" />
	</padding>
	<top>
		<VBox spacing="12.0">
			<Label style="-fx-font-size: 15px; -fx-font-weight: bold;"
				text="Administración de Categorías (Actividad 1, 2, 4 y 5)" />
			<GridPane hgap="10.0" vgap="8.0">
				<columnConstraints>
					<ColumnConstraints minWidth="80.0" prefWidth="90.0" />
					<ColumnConstraints hgrow="ALWAYS" minWidth="180.0"
						prefWidth="260.0" />
				</columnConstraints>
				<rowConstraints>
					<RowConstraints minHeight="28.0" />
					<RowConstraints minHeight="28.0" />
				</rowConstraints>
				<children>
					<Label fx:id="labelId" text="ID:" GridPane.columnIndex="0"
						GridPane.rowIndex="0" />
					<TextField fx:id="Tid" editable="false"
						GridPane.columnIndex="1" GridPane.rowIndex="0" />

					<Label fx:id="labelCategoria" text="Categoría:"
						GridPane.columnIndex="0" GridPane.rowIndex="1" />
					<TextField fx:id="Tcategoria" editable="false"
						GridPane.columnIndex="1" GridPane.rowIndex="1" />
				</children>
			</GridPane>
			<HBox alignment="CENTER" spacing="12.0">
				<Button fx:id="Bagregar" onAction="#onAltas" prefWidth="105.0"
					text="Agregar" />
				<Button fx:id="Bmodal" onAction="#onAbrirModalCategoria"
					prefWidth="165.0" text="Agregar/Modificar (Modal)" />
				<Button fx:id="Beliminar" onAction="#onEliminar"
					prefWidth="105.0" text="Eliminar" />
				<Button fx:id="Bsalir" onAction="#onSalir" prefWidth="90.0"
					text="Salir" />
			</HBox>
		</VBox>
	</top>
	<center>
		<ScrollPane fx:id="scrollPane" fitToHeight="true"
			fitToWidth="true" BorderPane.alignment="CENTER">
			<BorderPane.margin>
				<Insets top="12.0" />
			</BorderPane.margin>
			<content>
				<TableView fx:id="Tcategorias">
					<columns>
						<TableColumn fx:id="colId" prefWidth="120.0"
							text="ID Categoría" />
						<TableColumn fx:id="colCategoria" prefWidth="360.0"
							text="Nombre de Categoría" />
					</columns>
				</TableView>
			</content>
		</ScrollPane>
	</center>
</BorderPane>
