<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Slider?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.RowConstraints?>

<GridPane fx:id="panel" hgap="15.0" prefHeight="400.0" prefWidth="442.0"
	vgap="10.0" xmlns="http://javafx.com/javafx/21"
	xmlns:fx="http://javafx.com/fxml/1"
	fx:controller="controlador.ControladorPractica02_c">
	<padding>
		<Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
	</padding>
	<columnConstraints>
		<ColumnConstraints hgrow="SOMETIMES" maxWidth="170.0"
			minWidth="140.0" prefWidth="150.0" />
		<ColumnConstraints hgrow="ALWAYS" minWidth="180.0"
			prefWidth="220.0" />
	</columnConstraints>
	<rowConstraints>
		<RowConstraints minHeight="30.0" vgrow="SOMETIMES" />
		<RowConstraints minHeight="30.0" vgrow="SOMETIMES" />
		<RowConstraints minHeight="30.0" vgrow="SOMETIMES" />
		<RowConstraints minHeight="50.0" vgrow="SOMETIMES" />
		<RowConstraints minHeight="30.0" vgrow="SOMETIMES" />
		<RowConstraints minHeight="30.0" vgrow="SOMETIMES" />
		<RowConstraints minHeight="45.0" vgrow="SOMETIMES" />
		<RowConstraints minHeight="30.0" vgrow="SOMETIMES" />
	</rowConstraints>
	<children>
		<Label fx:id="etiqueta1" text="Button (JButton):"
			GridPane.columnIndex="0" GridPane.rowIndex="0" />
		<Button fx:id="Bsalir" maxWidth="1.7976931348623157E308"
			onAction="#onSalir" text="Haz clic para Salir"
			GridPane.columnIndex="1" GridPane.rowIndex="0" />

		<Label fx:id="etiqueta2" text="TextField (JTextField):"
			GridPane.columnIndex="0" GridPane.rowIndex="1" />
		<TextField fx:id="campoTexto" GridPane.columnIndex="1"
			GridPane.rowIndex="1" />

		<Label fx:id="etiqueta3" text="PasswordField (JPasswordField):"
			GridPane.columnIndex="0" GridPane.rowIndex="2" />
		<PasswordField fx:id="campoPassword" GridPane.columnIndex="1"
			GridPane.rowIndex="2" />

		<Label fx:id="etiqueta4" text="TextArea (JTextArea):"
			GridPane.columnIndex="0" GridPane.rowIndex="3" />
		<ScrollPane fx:id="scrollPane" fitToHeight="true"
			fitToWidth="true" prefHeight="55.0" GridPane.columnIndex="1"
			GridPane.rowIndex="3">
			<content>
				<TextArea fx:id="areaTexto" prefRowCount="2" wrapText="true" />
			</content>
		</ScrollPane>

		<Label fx:id="etiqueta5" text="FormattedTextField:"
			GridPane.columnIndex="0" GridPane.rowIndex="4" />
		<TextField fx:id="campoFormateado" text="12345.67"
			GridPane.columnIndex="1" GridPane.rowIndex="4" />

		<Label fx:id="etiqueta6" text="Spinner (JSpinner):"
			GridPane.columnIndex="0" GridPane.rowIndex="5" />
		<Spinner fx:id="spinner" editable="true"
			maxWidth="1.7976931348623157E308" GridPane.columnIndex="1"
			GridPane.rowIndex="5" />

		<Label fx:id="etiqueta7" text="Slider (JSlider):"
			GridPane.columnIndex="0" GridPane.rowIndex="6" />
		<Slider fx:id="slider" majorTickUnit="20.0" max="100.0"
			minorTickCount="3" showTickLabels="true" showTickMarks="true"
			value="50.0" GridPane.columnIndex="1" GridPane.rowIndex="6" />

		<Label fx:id="etiqueta8" text="ComboBox (JComboBox):"
			GridPane.columnIndex="0" GridPane.rowIndex="7" />
		<ComboBox fx:id="comboBox" maxWidth="1.7976931348623157E308"
			GridPane.columnIndex="1" GridPane.rowIndex="7" />
	</children>
</GridPane>
