<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane fx:id="contentPane" prefHeight="220.0" prefWidth="360.0"
	style="-fx-border-color: #3b5998; -fx-border-width: 2px;"
	xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
	fx:controller="controlador.ControladorVentanaEmergente">
	<padding>
		<Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
	</padding>
	<center>
		<VBox alignment="CENTER" spacing="12.0">
			<Label fx:id="lblTitulo" style="-fx-font-size: 15px; -fx-font-weight: bold;"
				text="Ventana" />
			<Label fx:id="lblDescripcion" wrapText="true"
				text="Descripción de la ventana" />
			<Button fx:id="btnCerrar" onAction="#onCerrar" text="Cerrar" />
		</VBox>
	</center>
</BorderPane>
