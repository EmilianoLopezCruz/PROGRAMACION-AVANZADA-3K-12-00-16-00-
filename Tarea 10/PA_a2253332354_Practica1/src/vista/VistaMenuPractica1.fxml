<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Menu?>
<?import javafx.scene.control.MenuBar?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane fx:id="panelRaiz" prefHeight="480.0" prefWidth="680.0"
	xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
	fx:controller="controlador.ControladorMenuPractica1">
	<top>
		<MenuBar fx:id="barraMenu">
			<menus>
				<Menu fx:id="menuParte1" text="Parte 1 (Contenedores y Eventos)">
					<items>
						<MenuItem fx:id="miPractica01_01" onAction="#onAbrirPractica01_01"
							text="Practica01_01 / 02 / 03 (Stage, Sin Bordes y Modal)" />
						<MenuItem fx:id="miPractica01_01_b"
							onAction="#onAbrirPractica01_01_b"
							text="Practica01_01_b (TabPane, ScrollPane y Ventana Interna)" />
						<MenuItem fx:id="miPractica02_b2" onAction="#onAbrirPractica02_b2"
							text="Practica02_a / b / b2 (Botón Salir con Mnemónico)" />
						<MenuItem fx:id="miPractica02_c" onAction="#onAbrirPractica02_c"
							text="Practica02_c (Componentes de Entrada JavaFX)" />
					</items>
				</Menu>
				<Menu fx:id="menuParte2" text="Parte 2 y Reporte (MVC Categorías e Insumos)">
					<items>
						<MenuItem fx:id="miPractica03_a" onAction="#onAbrirPractica03_a"
							text="Practica03_a (Administración de Productos en Memoria)" />
						<MenuItem fx:id="miPractica03_b" onAction="#onAbrirPractica03_b"
							text="Actividad 1 - Practica03_b (Categorías en Memoria)" />
						<MenuItem fx:id="miPractica03_c" onAction="#onAbrirPractica03_c"
							text="Actividad 3 - Practica03_c (Categorías con Archivo TXT)" />
						<MenuItem fx:id="miPractica03_d" onAction="#onAbrirPractica03_d"
							text="Actividad 4 - Practica03_d (Productos y Categorías con TXT)" />
					</items>
				</Menu>
				<Menu fx:id="menuSalir" text="Salir">
					<items>
						<MenuItem fx:id="miSalir" onAction="#onSalirSistema"
							text="Cerrar Aplicación" />
					</items>
				</Menu>
			</menus>
		</MenuBar>
	</top>
	<center>
		<VBox fx:id="panelBienvenida" alignment="CENTER" spacing="12.0">
			<padding>
				<Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
			</padding>
			<children>
				<Label style="-fx-font-size: 18px; -fx-font-weight: bold;"
					text="PA_a2253332354_Practica1 — JavaFX + FXML + MVC" />
				<Label
					text="Selecciona cualquier ejercicio desde la barra de menú superior para cargarlo o abrir su ventana." />
			</children>
		</VBox>
	</center>
</BorderPane>
