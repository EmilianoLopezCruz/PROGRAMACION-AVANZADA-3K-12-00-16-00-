<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TitledPane?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>

<TabPane fx:id="contentPane" prefHeight="300.0" prefWidth="450.0"
	tabClosingPolicy="UNAVAILABLE" xmlns="http://javafx.com/javafx/21"
	xmlns:fx="http://javafx.com/fxml/1"
	fx:controller="controlador.ControladorPractica01_01_b">
	<padding>
		<Insets bottom="5.0" left="5.0" right="5.0" top="5.0" />
	</padding>
	<tabs>
		<Tab fx:id="tab1" text="Pestaña 1">
			<content>
				<AnchorPane fx:id="panelPestana1" />
			</content>
		</Tab>
		<Tab fx:id="tab2" text="Pestaña 2">
			<content>
				<ScrollPane fx:id="scrollPane" hbarPolicy="ALWAYS"
					vbarPolicy="ALWAYS">
					<content>
						<AnchorPane minHeight="400.0" minWidth="600.0">
							<children>
								<Label layoutX="20.0" layoutY="20.0"
									text="ScrollPane con barras de desplazamiento siempre visibles" />
							</children>
						</AnchorPane>
					</content>
				</ScrollPane>
			</content>
		</Tab>
		<Tab fx:id="tab3" text="Pestaña 3">
			<content>
				<Pane fx:id="desktopPane" style="-fx-background-color: #e8eef5;" />
			</content>
		</Tab>
		<Tab fx:id="tab4" text="Pestaña 4">
			<content>
				<Pane fx:id="panelContenedorInterno" style="-fx-background-color: #dfe6ed;">
					<children>
						<TitledPane fx:id="internalFrame" collapsible="true"
							layoutX="15.0" layoutY="15.0" prefHeight="200.0" prefWidth="380.0"
							text="New JInternalFrame (Ventana Interna JavaFX)">
							<content>
								<VBox alignment="CENTER" spacing="10.0">
									<Label text="Ventana interna simulada dentro de TabPane" />
									<Button fx:id="btnCerrarInterna" onAction="#onToggleInternalFrame"
										text="Ocultar / Mostrar Contenido" />
								</VBox>
							</content>
						</TitledPane>
					</children>
				</Pane>
			</content>
		</Tab>
	</tabs>
</TabPane>
