<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>

<BorderPane fx:id="panelFormulario" prefHeight="370.0"
	prefWidth="420.0" xmlns="http://javafx.com/javafx/21"
	xmlns:fx="http://javafx.com/fxml/1"
	fx:controller="controlador.ControladorPractica03_d">
	<padding>
		<Insets bottom="12.0" left="12.0" right="12.0" top="12.0" />
	</padding>
	<top>
		<VBox spacing="12.0">
			<GridPane hgap="10.0" vgap="8.0">
				<columnConstraints>
					<ColumnConstraints minWidth="75.0" prefWidth="85.0" />
					<ColumnConstraints hgrow="ALWAYS" minWidth="160.0"
						prefWidth="220.0" />
				</columnConstraints>
				<rowConstraints>
					<RowConstraints minHeight="28.0" />
					<RowConstraints minHeight="28.0" />
					<RowConstraints minHeight="28.0" />
				</rowConstraints>
				<children>
					<Label fx:id="labelId" text="ID:" GridPane.columnIndex="0"
						GridPane.rowIndex="0" />
					<TextField fx:id="Tid" editable="false"
						GridPane.columnIndex="1" GridPane.rowIndex="0" />

					<Label fx:id="labelInsumo" text="Insumo:"
						GridPane.columnIndex="0" GridPane.rowIndex="1" />
					<TextField fx:id="Tinsumo" editable="false"
						GridPane.columnIndex="1" GridPane.rowIndex="1" />

					<Label fx:id="labelCategoria" text="Categoría:"
						GridPane.columnIndex="0" GridPane.rowIndex="2" />
					<ComboBox fx:id="ComboCategoria" disable="true"
						maxWidth="1.7976931348623157E308" GridPane.columnIndex="1"
						GridPane.rowIndex="2" />
				</children>
			</GridPane>
			<HBox alignment="CENTER" spacing="18.0">
				<Button fx:id="Bagregar" onAction="#onAltas" prefWidth="110.0"
					text="Agregar" />
				<Button fx:id="Beliminar" onAction="#onEliminar"
					prefWidth="110.0" text="Eliminar" />
				<Button fx:id="Bsalir" onAction="#onSalir" prefWidth="90.0"
					text="Salir" />
			</HBox>
		</VBox>
	</top>
	<center>
		<ScrollPane fx:id="scrollPane" fitToHeight="true"
			fitToWidth="true" BorderPane.alignment="CENTER">
			<BorderPane.margin>
				<Insets top="12.0" />
			</BorderPane.margin>
			<content>
				<TextArea fx:id="areaProductos" editable="false" />
			</content>
		</ScrollPane>
	</center>
</BorderPane>
