<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<HBox spacing="22.0" styleClass="fondo-modulo" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Vistacontrolador.ControladorLaboratorios">
   <padding><Insets bottom="28.0" left="32.0" right="32.0" top="26.0" /></padding>
   <children>
      <VBox spacing="14.0" styleClass="tarjeta" HBox.hgrow="ALWAYS">
         <padding><Insets bottom="18.0" left="22.0" right="22.0" top="18.0" /></padding>
         <children>
            <HBox alignment="CENTER_LEFT" spacing="12.0">
               <children>
                  <VBox spacing="2.0">
                     <children>
                        <Label styleClass="titulo-tarjeta" text="Catálogo de laboratorios" />
                        <Label fx:id="lblEdificio" styleClass="subtitulo" text="" />
                     </children>
                  </VBox>
                  <Region HBox.hgrow="ALWAYS" />
                  <Button onAction="#nuevoLaboratorio" styleClass="btn-acento" text="＋  Agregar laboratorio" />
               </children>
            </HBox>
            <TableView fx:id="tabla" styleClass="tabla" VBox.vgrow="ALWAYS">
               <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY" /></columnResizePolicy>
               <columns>
                  <TableColumn fx:id="colId" maxWidth="80.0" minWidth="55.0" text="Clave" />
                  <TableColumn fx:id="colNombre" minWidth="95.0" text="Nombre" />
                  <TableColumn fx:id="colUbicacion" minWidth="90.0" text="Ubicación" />
                  <TableColumn fx:id="colCapacidad" maxWidth="90.0" minWidth="72.0" text="Capacidad" />
                  <TableColumn fx:id="colEquipos" maxWidth="80.0" minWidth="62.0" text="Equipos" />
                  <TableColumn fx:id="colResponsable" minWidth="90.0" text="Responsable" />
                  <TableColumn fx:id="colEstado" maxWidth="150.0" minWidth="115.0" text="Estado" />
               </columns>
            </TableView>
            <HBox spacing="10.0">
               <children>
                  <Button onAction="#editarSeleccionado" styleClass="btn-secundario" text="✎  Editar seleccionado" />
                  <Button onAction="#cambiarEstado" styleClass="btn-secundario" text="Cambiar estado (disponible / mantenimiento)" />
                  <Button onAction="#eliminarLaboratorio" styleClass="btn-peligro" text="🗑  Eliminar" />
               </children>
            </HBox>
         </children>
      </VBox>

      <ScrollPane fitToWidth="true" hbarPolicy="NEVER" minWidth="320.0" prefWidth="330.0" maxWidth="340.0" styleClass="scroll-limpio">
         <content>
            <VBox spacing="16.0" styleClass="fondo-modulo">
               <padding><Insets bottom="6.0" left="2.0" right="8.0" top="2.0" /></padding>
               <children>
                  <VBox spacing="12.0" styleClass="tarjeta">
                     <padding><Insets bottom="20.0" left="22.0" right="22.0" top="18.0" /></padding>
                     <children>
                        <Label fx:id="lblTituloDatos" styleClass="titulo-tarjeta" text="Datos del laboratorio" />
                        <Label fx:id="lblSubtituloDatos" styleClass="subtitulo" text="Edita el seleccionado o registra uno nuevo." wrapText="true" />
                        <HBox spacing="10.0">
                           <children>
                              <TextField fx:id="txtClave" promptText="Clave (auto)" styleClass="campo-texto" prefWidth="110.0" minWidth="100.0" />
                              <TextField fx:id="txtNombre" promptText="Nombre del laboratorio" styleClass="campo-texto" HBox.hgrow="ALWAYS" />
                           </children>
                        </HBox>
                        <VBox spacing="6.0">
                           <children>
                              <Label styleClass="etiqueta-campo" text="Edificio" />
                              <ComboBox fx:id="cmbEdificio" maxWidth="Infinity" styleClass="combo-caja" />
                           </children>
                        </VBox>
                        <VBox spacing="6.0">
                           <children>
                              <Label styleClass="etiqueta-campo" text="Planta" />
                              <ComboBox fx:id="cmbPlanta" maxWidth="Infinity" styleClass="combo-caja" />
                           </children>
                        </VBox>
                        <HBox spacing="10.0">
                           <children>
                              <VBox spacing="6.0" HBox.hgrow="ALWAYS">
                                 <children>
                                    <Label styleClass="etiqueta-campo" text="Alumnos (capacidad)" />
                                    <TextField fx:id="txtCapacidad" promptText="Ej. 30" styleClass="campo-texto" />
                                 </children>
                              </VBox>
                              <VBox spacing="6.0" HBox.hgrow="ALWAYS">
                                 <children>
                                    <Label styleClass="etiqueta-campo" text="Equipos" />
                                    <TextField fx:id="txtEquipos" promptText="Ej. 30" styleClass="campo-texto" />
                                 </children>
                              </VBox>
                           </children>
                        </HBox>
                        <TextField fx:id="txtSoftware" promptText="Software instalado" styleClass="campo-texto" />
                        <TextField fx:id="txtResponsable" promptText="Responsable" styleClass="campo-texto" />
                        <VBox spacing="6.0">
                           <children>
                              <Label styleClass="etiqueta-campo" text="Características del laboratorio" />
                              <TextArea fx:id="txtCaracteristicas" prefRowCount="3" promptText="Ej. Aire acondicionado, proyector, pizarrón" styleClass="area-texto" wrapText="true" />
                           </children>
                        </VBox>
                        <HBox spacing="10.0">
                           <children>
                              <Button maxWidth="Infinity" onAction="#guardarLaboratorio" styleClass="btn-primario" text="Guardar laboratorio" HBox.hgrow="ALWAYS" />
                              <Button onAction="#limpiar" styleClass="btn-secundario" text="Limpiar" />
                           </children>
                        </HBox>
                        <Label fx:id="lblMensaje" managed="false" maxWidth="Infinity" visible="false" wrapText="true" />
                     </children>
                  </VBox>

                  <VBox spacing="12.0" styleClass="tarjeta">
                     <padding><Insets bottom="20.0" left="22.0" right="22.0" top="18.0" /></padding>
                     <children>
                        <Label styleClass="titulo-tarjeta" text="Estado y anotaciones" />
                        <VBox spacing="6.0">
                           <children>
                              <Label styleClass="etiqueta-campo" text="Estado del laboratorio" />
                              <ComboBox fx:id="cmbEstado" maxWidth="Infinity" styleClass="combo-caja" />
                           </children>
                        </VBox>
                        <TextField fx:id="txtMotivo" promptText="Motivo del mantenimiento" styleClass="campo-texto" />
                        <VBox spacing="6.0">
                           <children>
                              <Label styleClass="etiqueta-campo" text="Fecha estimada de reapertura" />
                              <DatePicker fx:id="dpReapertura" maxWidth="Infinity" />
                           </children>
                        </VBox>
                        <TextArea fx:id="txtNota" prefRowCount="2" promptText="Escribe una anotación..." styleClass="area-texto" wrapText="true" />
                        <HBox spacing="10.0">
                           <children>
                              <Button maxWidth="Infinity" onAction="#guardarEstado" styleClass="btn-primario" text="Guardar estado" HBox.hgrow="ALWAYS" />
                              <Button onAction="#anotar" styleClass="btn-secundario" text="📝  Anotar" />
                           </children>
                        </HBox>
                        <Label fx:id="lblMensajeEstado" managed="false" maxWidth="Infinity" visible="false" wrapText="true" />
                        <Label styleClass="etiqueta-campo" text="Historial de anotaciones" />
                        <ListView fx:id="listaNotas" prefHeight="150.0" styleClass="lista-ocupacion" />
                     </children>
                  </VBox>
               </children>
            </VBox>
         </content>
      </ScrollPane>
   </children>
</HBox>
