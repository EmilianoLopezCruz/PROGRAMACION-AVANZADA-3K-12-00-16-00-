<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="22.0" styleClass="fondo-modulo" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Vistacontrolador.ControladorInicio">
   <padding><Insets bottom="28.0" left="32.0" right="32.0" top="26.0" /></padding>
   <children>
      <HBox alignment="CENTER_LEFT" spacing="12.0">
         <children>
            <VBox spacing="4.0">
               <children>
                  <Label styleClass="titulo-pagina" text="Resumen de hoy" />
                  <Label fx:id="lblBienvenida" styleClass="subtitulo" text="" />
               </children>
            </VBox>
            <Region HBox.hgrow="ALWAYS" />
            <Button onAction="#nuevoApartado" styleClass="btn-acento" text="＋  Nuevo apartado" />
         </children>
      </HBox>

      <HBox spacing="18.0">
         <children>
            <VBox spacing="6.0" styleClass="tarjeta-kpi, kpi-azul" HBox.hgrow="ALWAYS">
               <children>
                  <Label styleClass="kpi-etq" text="APARTADOS HOY" />
                  <Label fx:id="lblApartadosHoy" styleClass="kpi-valor" text="0" />
               </children>
            </VBox>
            <VBox spacing="6.0" styleClass="tarjeta-kpi, kpi-oro" HBox.hgrow="ALWAYS">
               <children>
                  <Label styleClass="kpi-etq" text="MAESTROS REGISTRADOS" />
                  <Label fx:id="lblMaestros" styleClass="kpi-valor" text="0" />
               </children>
            </VBox>
            <VBox spacing="6.0" styleClass="tarjeta-kpi, kpi-verde" HBox.hgrow="ALWAYS">
               <children>
                  <Label styleClass="kpi-etq" text="LABORATORIOS DISPONIBLES" />
                  <Label fx:id="lblLabsDisponibles" styleClass="kpi-valor" text="0" />
               </children>
            </VBox>
            <VBox spacing="6.0" styleClass="tarjeta-kpi, kpi-gris" HBox.hgrow="ALWAYS">
               <children>
                  <Label styleClass="kpi-etq" text="ALUMNOS ATENDIDOS HOY" />
                  <Label fx:id="lblAlumnosHoy" styleClass="kpi-valor" text="0" />
               </children>
            </VBox>
         </children>
      </HBox>

      <VBox spacing="14.0" styleClass="tarjeta" VBox.vgrow="ALWAYS">
         <padding><Insets bottom="18.0" left="22.0" right="22.0" top="18.0" /></padding>
         <children>
            <HBox alignment="CENTER_LEFT">
               <children>
                  <Label styleClass="titulo-tarjeta" text="Próximos apartados" />
                  <Region HBox.hgrow="ALWAYS" />
                  <Button onAction="#verApartados" styleClass="btn-secundario" text="Ver todos" />
               </children>
            </HBox>
            <TableView fx:id="tablaProximos" styleClass="tabla" VBox.vgrow="ALWAYS">
               <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY" /></columnResizePolicy>
               <columns>
                  <TableColumn fx:id="colFecha" text="Fecha" />
                  <TableColumn fx:id="colHorario" text="Horario" />
                  <TableColumn fx:id="colLab" text="Laboratorio" />
                  <TableColumn fx:id="colMateria" text="Materia / actividad" />
                  <TableColumn fx:id="colEstado" text="Estado" />
               </columns>
            </TableView>
         </children>
      </VBox>
   </children>
</VBox>
