<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<HBox spacing="22.0" styleClass="fondo-modulo" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Vistacontrolador.ControladorApartar">
   <padding><Insets bottom="28.0" left="32.0" right="32.0" top="26.0" /></padding>
   <children>
      <VBox spacing="16.0" styleClass="tarjeta" HBox.hgrow="ALWAYS" minWidth="440.0">
         <padding><Insets bottom="22.0" left="26.0" right="26.0" top="22.0" /></padding>
         <children>
            <Label styleClass="titulo-tarjeta" text="Datos del apartado" />
            <Label fx:id="lblSolicitante" styleClass="subtitulo" text="" />

            <VBox spacing="6.0">
               <children>
                  <Label styleClass="etiqueta-campo" text="Docente que solicita" />
                  <ComboBox fx:id="cmbDocente" maxWidth="Infinity" styleClass="combo-caja" />
               </children>
            </VBox>

            <VBox spacing="6.0">
               <children>
                  <Label styleClass="etiqueta-campo" text="Laboratorio" />
                  <ComboBox fx:id="cmbLab" maxWidth="Infinity" styleClass="combo-caja" />
               </children>
            </VBox>

            <HBox spacing="14.0">
               <children>
                  <VBox spacing="6.0" HBox.hgrow="ALWAYS">
                     <children>
                        <Label styleClass="etiqueta-campo" text="Fecha" />
                        <DatePicker fx:id="dpFecha" maxWidth="Infinity" />
                     </children>
                  </VBox>
                  <VBox spacing="6.0" HBox.hgrow="ALWAYS">
                     <children>
                        <Label styleClass="etiqueta-campo" text="Hora de inicio" />
                        <ComboBox fx:id="cmbInicio" maxWidth="Infinity" styleClass="combo-caja" />
                     </children>
                  </VBox>
                  <VBox spacing="6.0" HBox.hgrow="ALWAYS">
                     <children>
                        <Label styleClass="etiqueta-campo" text="Hora de fin" />
                        <ComboBox fx:id="cmbFin" maxWidth="Infinity" styleClass="combo-caja" />
                     </children>
                  </VBox>
               </children>
            </HBox>

            <HBox spacing="14.0">
               <children>
                  <VBox spacing="6.0" HBox.hgrow="ALWAYS">
                     <children>
                        <Label styleClass="etiqueta-campo" text="Materia o actividad" />
                        <TextField fx:id="txtMateria" promptText="Ej. Estructura de datos" styleClass="campo-texto" />
                     </children>
                  </VBox>
                  <VBox spacing="6.0" prefWidth="110.0">
                     <children>
                        <Label styleClass="etiqueta-campo" text="Grupo" />
                        <TextField fx:id="txtGrupo" promptText="Ej. 3K" styleClass="campo-texto" />
                     </children>
                  </VBox>
                  <VBox spacing="6.0" prefWidth="110.0">
                     <children>
                        <Label styleClass="etiqueta-campo" text="Alumnos" />
                        <TextField fx:id="txtAlumnos" promptText="Ej. 25" styleClass="campo-texto" />
                     </children>
                  </VBox>
               </children>
            </HBox>

            <VBox spacing="6.0">
               <children>
                  <Label styleClass="etiqueta-campo" text="Motivo / observaciones (opcional)" />
                  <TextArea fx:id="txtMotivo" prefRowCount="3" promptText="Ej. Práctica de bases de datos, requiere MySQL" styleClass="area-texto" wrapText="true" />
               </children>
            </VBox>

            <HBox spacing="12.0">
               <children>
                  <Button onAction="#registrar" styleClass="btn-primario" text="Registrar apartado" />
                  <Button onAction="#limpiar" styleClass="btn-secundario" text="Limpiar" />
               </children>
            </HBox>
            <Label fx:id="lblMensaje" managed="false" maxWidth="Infinity" visible="false" wrapText="true" />
         </children>
      </VBox>

      <VBox spacing="16.0" prefWidth="360.0" minWidth="320.0" maxWidth="380.0">
         <children>
            <VBox spacing="10.0" styleClass="tarjeta">
               <padding><Insets bottom="18.0" left="22.0" right="22.0" top="18.0" /></padding>
               <children>
                  <Label styleClass="titulo-tarjeta" text="Información del laboratorio" />
                  <Label fx:id="lblInfoLab" styleClass="info-lab" wrapText="true" text="" />
               </children>
            </VBox>
            <VBox spacing="10.0" styleClass="tarjeta" VBox.vgrow="ALWAYS">
               <padding><Insets bottom="18.0" left="22.0" right="22.0" top="18.0" /></padding>
               <children>
                  <Label fx:id="lblTituloOcupacion" styleClass="titulo-tarjeta" text="Ocupación del día" />
                  <ListView fx:id="listaOcupacion" styleClass="lista-ocupacion" VBox.vgrow="ALWAYS" />
               </children>
            </VBox>
         </children>
      </VBox>
   </children>
</HBox>
