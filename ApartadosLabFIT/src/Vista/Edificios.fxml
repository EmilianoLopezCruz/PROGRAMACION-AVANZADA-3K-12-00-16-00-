<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<HBox fx:id="raiz" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Vistacontrolador.ControladorEdificios">
   <children>
      <VBox alignment="CENTER_LEFT" prefWidth="460.0" minWidth="460.0" spacing="14.0" styleClass="login-lado">
         <padding><Insets bottom="40.0" left="50.0" right="40.0" top="40.0" /></padding>
         <children>
            <StackPane styleClass="logo-uat-grande" maxWidth="86.0" maxHeight="86.0" minWidth="86.0" minHeight="86.0">
               <children><Label styleClass="logo-uat-texto" text="UAT" /></children>
            </StackPane>
            <Label styleClass="login-marca" text="Universidad Autónoma de Tamaulipas" wrapText="true" />
            <Label styleClass="login-facultad" text="Facultad de Ingeniería Tampico" wrapText="true" />
            <Label styleClass="login-lema" text="Sistema de Apartado de Laboratorios" wrapText="true">
               <VBox.margin><Insets top="30.0" /></VBox.margin>
            </Label>
            <Label styleClass="login-descripcion" text="Consulta la disponibilidad, da seguimiento a los apartados y administra los laboratorios, los edificios y los maestros." wrapText="true" />
         </children>
      </VBox>
      <StackPane styleClass="login-form-fondo" HBox.hgrow="ALWAYS">
         <children>
            <VBox maxWidth="440.0" maxHeight="-Infinity" spacing="12.0" styleClass="login-tarjeta">
               <padding><Insets bottom="28.0" left="30.0" right="30.0" top="28.0" /></padding>
               <children>
                  <Label styleClass="login-titulo" text="Selecciona un edificio" />
                  <Label styleClass="subtitulo" text="Elige dónde vas a administrar los laboratorios" wrapText="true" />

                  <ScrollPane fx:id="scrollEdificios" fitToWidth="true" hbarPolicy="NEVER" maxHeight="330.0" styleClass="scroll-limpio">
                     <content>
                        <VBox fx:id="listaEdificios" spacing="10.0">
                           <padding><Insets bottom="6.0" left="4.0" right="4.0" top="4.0" /></padding>
                        </VBox>
                     </content>
                  </ScrollPane>

                  <Button fx:id="btnAgregar" maxWidth="Infinity" onAction="#agregarEdificio" styleClass="btn-acento" text="＋   Agregar edificio" />
                  <Button fx:id="btnAyuda" maxWidth="Infinity" onAction="#verAyuda" styleClass="btn-secundario" text="❓   ¿Cómo funciona?" />
                  <Label styleClass="login-nota" text="Teclas 1 a 9 eligen el edificio  ·  ↑ ↓ mueven  ·  Enter abre  ·  A agrega un edificio  ·  H abre la ayuda" wrapText="true" />
               </children>
            </VBox>
         </children>
      </StackPane>
   </children>
</HBox>
