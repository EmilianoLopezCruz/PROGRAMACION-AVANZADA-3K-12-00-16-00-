<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.BarChart?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="18.0" styleClass="fondo-modulo" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Vistacontrolador.ControladorReportes">
   <padding><Insets bottom="28.0" left="32.0" right="32.0" top="26.0" /></padding>
   <children>
      <HBox alignment="CENTER_LEFT" spacing="12.0">
         <children>
            <VBox spacing="4.0">
               <children>
                  <Label styleClass="titulo-pagina" text="Estadística de uso" />
                  <Label fx:id="lblSubtitulo" styleClass="subtitulo" text="" />
               </children>
            </VBox>
            <Region HBox.hgrow="ALWAYS" />
            <Label styleClass="etiqueta-campo" text="Desde" />
            <DatePicker fx:id="dpDesde" prefWidth="140.0" />
            <Label styleClass="etiqueta-campo" text="Hasta" />
            <DatePicker fx:id="dpHasta" prefWidth="140.0" />
            <Button onAction="#generar" styleClass="btn-primario" text="Generar" />
            <Button onAction="#exportar" styleClass="btn-acento" text="Exportar TXT" />
         </children>
      </HBox>

      <Label fx:id="lblMensaje" managed="false" maxWidth="Infinity" visible="false" wrapText="true" />

      <HBox spacing="18.0" VBox.vgrow="ALWAYS">
         <children>
            <VBox spacing="12.0" styleClass="tarjeta" HBox.hgrow="ALWAYS" prefWidth="520.0">
               <padding><Insets bottom="18.0" left="22.0" right="22.0" top="18.0" /></padding>
               <children>
                  <Label styleClass="titulo-tarjeta" text="Uso por laboratorio" />
                  <TableView fx:id="tabla" styleClass="tabla" VBox.vgrow="ALWAYS">
                     <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY" /></columnResizePolicy>
                     <columns>
                        <TableColumn fx:id="colLab" minWidth="170.0" text="Laboratorio" />
                        <TableColumn fx:id="colApartados" text="Apartados" />
                        <TableColumn fx:id="colHoras" text="Horas" />
                        <TableColumn fx:id="colAlumnos" text="Alumnos" />
                     </columns>
                  </TableView>
               </children>
            </VBox>
            <VBox spacing="12.0" styleClass="tarjeta" HBox.hgrow="ALWAYS" prefWidth="520.0">
               <padding><Insets bottom="18.0" left="22.0" right="22.0" top="18.0" /></padding>
               <children>
                  <Label styleClass="titulo-tarjeta" text="Horas apartadas" />
                  <BarChart fx:id="grafica" VBox.vgrow="ALWAYS">
                     <xAxis><CategoryAxis side="BOTTOM" /></xAxis>
                     <yAxis><NumberAxis side="LEFT" label="Horas" /></yAxis>
                  </BarChart>
               </children>
            </VBox>
         </children>
      </HBox>
   </children>
</VBox>
