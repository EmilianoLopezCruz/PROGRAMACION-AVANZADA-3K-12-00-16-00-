<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<HBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Vistacontrolador.ControladorLogin">
   <children>
      <VBox alignment="CENTER_LEFT" prefWidth="460.0" minWidth="460.0" spacing="14.0" styleClass="login-lado">
         <padding><Insets bottom="40.0" left="50.0" right="40.0" top="40.0" /></padding>
         <children>
            <StackPane styleClass="logo-uat-grande" maxWidth="86.0" maxHeight="86.0" minWidth="86.0" minHeight="86.0">
               <children><Label styleClass="logo-uat-texto" text="UAT" /></children>
            </StackPane>
            <Label styleClass="login-marca" text="Universidad Autónoma de Tamaulipas" wrapText="true" />
            <Label styleClass="login-facultad" text="Facultad de Ingeniería Tampico" wrapText="true" />
            <Label styleClass="login-lema" text="Sistema de Apartado de Laboratorios" wrapText="true">
               <VBox.margin><Insets top="30.0" /></VBox.margin>
            </Label>
            <Label styleClass="login-descripcion" text="Reserva salas de cómputo y laboratorios, consulta la disponibilidad en tiempo real y evita traslapes de horario." wrapText="true" />
         </children>
      </VBox>
      <StackPane styleClass="login-form-fondo" HBox.hgrow="ALWAYS">
         <children>
            <VBox maxWidth="380.0" maxHeight="440.0" spacing="14.0" styleClass="login-tarjeta">
               <padding><Insets bottom="32.0" left="32.0" right="32.0" top="30.0" /></padding>
               <children>
                  <Label styleClass="login-titulo" text="Iniciar sesión" />
                  <Label styleClass="subtitulo" text="Ingresa con tu usuario institucional" />
                  <VBox spacing="6.0">
                     <children>
                        <Label styleClass="etiqueta-campo" text="Usuario" />
                        <TextField fx:id="txtClave" promptText="Ej. docente" styleClass="campo-texto" />
                     </children>
                  </VBox>
                  <VBox spacing="6.0">
                     <children>
                        <Label styleClass="etiqueta-campo" text="Contraseña" />
                        <PasswordField fx:id="txtPass" promptText="••••" styleClass="campo-texto" />
                     </children>
                  </VBox>
                  <Button maxWidth="Infinity" onAction="#ingresar" styleClass="btn-primario" text="Ingresar" />
                  <Label styleClass="login-nota" wrapText="true" text="Prototipo de demostración: presiona Ingresar para continuar" />
               </children>
            </VBox>
         </children>
      </StackPane>
   </children>
</HBox>
