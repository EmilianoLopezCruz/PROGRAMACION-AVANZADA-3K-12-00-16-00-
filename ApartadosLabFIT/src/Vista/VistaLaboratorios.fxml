<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<HBox spacing="22.0" styleClass="fondo-modulo" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Vistacontrolador.ControladorLaboratorios">
   <padding><Insets bottom="28.0" left="32.0" right="32.0" top="26.0" /></padding>
   <children>
      <VBox spacing="14.0" styleClass="tarjeta" HBox.hgrow="ALWAYS">
         <padding><Insets bottom="18.0" left="22.0" right="22.0" top="18.0" /></padding>
         <children>
            <Label styleClass="titulo-tarjeta" text="Catálogo de laboratorios" />
            <TableView fx:id="tabla" styleClass="tabla" VBox.vgrow="ALWAYS">
               <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY" /></columnResizePolicy>
               <columns>
                  <TableColumn fx:id="colId" maxWidth="80.0" minWidth="65.0" text="Clave" />
                  <TableColumn fx:id="colNombre" minWidth="170.0" text="Nombre" />
                  <TableColumn fx:id="colUbicacion" minWidth="150.0" text="Ubicación" />
                  <TableColumn fx:id="colCapacidad" maxWidth="90.0" minWidth="70.0" text="Capacidad" />
                  <TableColumn fx:id="colEquipos" maxWidth="80.0" minWidth="65.0" text="Equipos" />
                  <TableColumn fx:id="colResponsable" minWidth="130.0" text="Responsable" />
                  <TableColumn fx:id="colEstado" maxWidth="150.0" minWidth="120.0" text="Estado" />
               </columns>
            </TableView>
            <Button styleClass="btn-secundario" text="Cambiar estado (disponible / mantenimiento)" />
         </children>
      </VBox>

      <VBox spacing="12.0" styleClass="tarjeta" prefWidth="330.0" minWidth="310.0" maxWidth="340.0">
         <padding><Insets bottom="20.0" left="22.0" right="22.0" top="18.0" /></padding>
         <children>
            <Label styleClass="titulo-tarjeta" text="Registrar laboratorio" />
            <TextField promptText="Clave (Ej. LAB-06)" styleClass="campo-texto" />
            <TextField promptText="Nombre" styleClass="campo-texto" />
            <TextField promptText="Ubicación" styleClass="campo-texto" />
            <HBox spacing="10.0">
               <children>
                  <TextField promptText="Capacidad" styleClass="campo-texto" HBox.hgrow="ALWAYS" />
                  <TextField promptText="Equipos" styleClass="campo-texto" HBox.hgrow="ALWAYS" />
               </children>
            </HBox>
            <TextField promptText="Software instalado" styleClass="campo-texto" />
            <TextField promptText="Responsable" styleClass="campo-texto" />
            <Button maxWidth="Infinity" styleClass="btn-primario" text="Guardar laboratorio" />
         </children>
      </VBox>
   </children>
</HBox>
