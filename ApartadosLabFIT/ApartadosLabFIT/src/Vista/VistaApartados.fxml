<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="18.0" styleClass="fondo-modulo" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Vistacontrolador.ControladorApartados">
   <padding><Insets bottom="28.0" left="32.0" right="32.0" top="26.0" /></padding>
   <children>
      <VBox spacing="4.0">
         <children>
            <Label styleClass="titulo-pagina" text="Listado de apartados" />
            <Label styleClass="subtitulo" text="Mostrando únicamente tus solicitudes." />
         </children>
      </VBox>

      <VBox spacing="14.0" styleClass="tarjeta" VBox.vgrow="ALWAYS">
         <padding><Insets bottom="18.0" left="22.0" right="22.0" top="18.0" /></padding>
         <children>
            <HBox alignment="CENTER_LEFT" spacing="12.0">
               <children>
                  <TextField minWidth="280.0" promptText="🔍  Buscar por materia, laboratorio, grupo o folio" styleClass="campo-texto" />
                  <ComboBox fx:id="cmbEstado" prefWidth="160.0" styleClass="combo-caja" />
                  <Region HBox.hgrow="ALWAYS" />
                  <Button styleClass="btn-primario" text="✔  Confirmar" />
                  <Button styleClass="btn-peligro" text="✖  Cancelar apartado" />
               </children>
            </HBox>
            <TableView fx:id="tabla" styleClass="tabla" VBox.vgrow="ALWAYS">
               <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY" /></columnResizePolicy>
               <columns>
                  <TableColumn fx:id="colFolio" maxWidth="90.0" minWidth="70.0" text="Folio" />
                  <TableColumn fx:id="colLab" minWidth="170.0" text="Laboratorio" />
                  <TableColumn fx:id="colFecha" maxWidth="110.0" minWidth="90.0" text="Fecha" />
                  <TableColumn fx:id="colHorario" maxWidth="120.0" minWidth="100.0" text="Horario" />
                  <TableColumn fx:id="colMateria" minWidth="150.0" text="Materia" />
                  <TableColumn fx:id="colGrupo" maxWidth="70.0" minWidth="55.0" text="Grupo" />
                  <TableColumn fx:id="colSolicitante" minWidth="140.0" text="Solicitante" />
                  <TableColumn fx:id="colEstado" maxWidth="130.0" minWidth="100.0" text="Estado" />
               </columns>
            </TableView>
         </children>
      </VBox>
   </children>
</VBox>
